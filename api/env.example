NODE_ENV=development
# Set ALLOW_DEV_OTP=true to accept any 6-digit OTP for login (when Supabase email is not configured)
ALLOW_DEV_OTP=true
PORT=5000
# Trust proxy: set to 1 for development/production with proxies, handles X-Forwarded-For headers
TRUST_PROXY=1

# Supabase Configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL connection strings for server-side database access only
DATABASE_URL=postgresql://username:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://username:password@host:5432/postgres

# JWT Configuration
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=MERN Quest <your-email@gmail.com>

# Client URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Google OAuth
# Aliases GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET are also supported.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional. If omitted, backend uses http(s)://<api-host>/api/auth/google/callback.
# Alias GOOGLE_CALLBACK_URL is also supported.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Judge Runtime
EXECUTION_TIMEOUT_MS=3000
