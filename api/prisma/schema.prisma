datasource db {
  provider  = "postgresql"
  url       = "postgresql://postgres.ivxmrpjbxueioymbmigf:VyxoJwTbGBreCRTY@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
  directUrl = "postgresql://postgres.ivxmrpjbxueioymbmigf:VyxoJwTbGBreCRTY@aws-1-us-east-1.pooler.supabase.com:5432/postgres"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username   String      @unique
  email      String      @unique
  name       String?
  role       String      @default("user")
  avatar     String      @default("default")
  points     Int         @default(0)
  level      Int         @default(1)
  streak     Int         @default(0)
  last_login DateTime?
  created_at DateTime    @default(now())

  authLogins AuthLogin[]
  quizzesCreated Quiz[]
  quizScores QuizScore[]

  @@map("users")
}

model AuthLogin {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  method        String   @default("password")
  password_hash String
  ip_address    String?
  user_agent    String?
  is_active     Boolean  @default(true)
  is_verified   Boolean  @default(true)
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("auth_logins")
}

model QuizCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  title      String?
  created_at DateTime @default(now())

  quizzes Quiz[]

  @@map("quiz_categories")
}

model Quiz {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id   String   @db.Uuid
  title         String
  description   String?
  question_text String
  options       String[]
  answer        String
  explanation   String?
  difficulty    String   @default("medium")
  points        Int      @default(10)
  time_limit    Int      @default(30)
  created_by    String   @db.Uuid
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  category QuizCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  creator  User         @relation(fields: [created_by], references: [id], onDelete: SetNull)

  scores QuizScore[]

  @@map("quizzes")
}

model QuizScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  quiz_id         String?  @db.Uuid
  score           Int
  total_questions Int
  correct_answers Int
  time_taken      Int      @default(0)
  points_earned   Int      @default(0)
  streak          Int      @default(0)
  created_at      DateTime @default(now())

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  quiz Quiz? @relation(fields: [quiz_id], references: [id], onDelete: SetNull)

  @@map("quiz_scores")
}
